// htdocs/dev-config.js.example
//
// Copy this file to htdocs/dev-config.js (gitignored, development only) to
// point the browser at the local dev ports for the Deno proxy and datasetd.
//
//   cp htdocs/dev-config.js.example htdocs/dev-config.js
//
// If both ports below match `host:` and `proxy.port:` in
// content_dashboard.yaml, no edits are needed. In production this file is
// absent and the browser falls back to relative paths
// (/content-dashboard/api/...) which Apache routes to the correct service.
window.__DEV_CONFIG__ = {
  apiBase: "http://localhost:8080", // Deno proxy (LibGuides, whoami, config)
  datasetBase: "http://localhost:8200", // datasetd (stewardship, audit CRUD)
};
